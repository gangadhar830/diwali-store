PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-64-chars
ADMIN_EMAIL=admin@yourshop.com
ADMIN_PASSWORD=ChangeMe@12345
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
NODE_ENV=development

SHOP_NAME=Sivakasi Sparks
BASE_URL=http://localhost:3000
GSTIN=
# Delivery: charge in rupees, free above this order value
DELIVERY_CHARGE=80
FREE_DELIVERY_ABOVE=1500
# Razorpay webhook secret (you choose it, then paste the same value in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-secret
# Email (Gmail: smtp.gmail.com, port 587, user = your gmail, pass = 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourshop@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Sivakasi Sparks <yourshop@gmail.com>
ADMIN_NOTIFY_EMAIL=yourshop@gmail.com
# SMS (optional, Twilio). Leave blank to skip SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ADMIN_PHONE=

# Shown in the website footer
SHOP_ADDRESS=12, Main Road, Sivakasi, Tamil Nadu 626123
SHOP_PHONE=+91 98765 43210
SHOP_WHATSAPP=919876543210
SHOP_EMAIL=yourshop@gmail.com
SHOP_HOURS=Open daily 9 AM to 9 PM
EXPLOSIVES_LICENSE=
